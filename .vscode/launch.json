{
  // The modules under src/ import each other relatively, so they have to be
  // launched as modules ("module": "src.main_gui"), not as scripts
  // ("program": "src/main_gui.py") - the latter fails with
  // "attempted relative import with no known parent package".
  "version": "0.2.0",
  "configurations": [
    {
      "name": "OpenMCR: graphical interface",
      "type": "debugpy",
      "request": "launch",
      "module": "src.main_gui",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "OpenMCR: command line",
      "type": "debugpy",
      "request": "launch",
      "module": "src.main",
      "cwd": "${workspaceFolder}",
      "args": ["${input:inputFolder}", "${input:outputFolder}", "--variant", "cajcl"],
      "console": "integratedTerminal"
    },
    {
      "name": "OpenMCR: regenerate the answer sheet",
      "type": "debugpy",
      "request": "launch",
      "module": "src.sheet_generation",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "id": "inputFolder",
      "type": "promptString",
      "description": "Folder holding the scanned sheets"
    },
    {
      "id": "outputFolder",
      "type": "promptString",
      "description": "Folder to write the CSV results to"
    }
  ]
}
